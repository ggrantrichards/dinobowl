{
  "hosting": [
    {
      "site": "gridiron-den",
      "public": "static",
      "predeploy": [
        "python3 \"$PROJECT_DIR/prepare_deploy.py\""
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/game/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/gridiron/games.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/gridiron/data.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/gridiron/engine.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "football-dino",
      "public": "redirect",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://gridiron-den.web.app/:path*",
          "type": 301
        }
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}
